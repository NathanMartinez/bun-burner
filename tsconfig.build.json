{
  "extends": "./tsconfig.core.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "files": [
    "src/core.ts",
    "src/app.ts",
    "src/index.ts"
  ]
}
