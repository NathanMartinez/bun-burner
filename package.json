{
  "name": "bun-burner",
  "version": "0.1.0-beta.1",
  "description": "Source-preserving two-way synchronization for Bitburner.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NathanMartinez/bun-burner.git"
  },
  "module": "./dist/app.js",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22",
    "@types/ws": "^8.18.1",
    "typescript": "^7"
  },
  "scripts": {
    "init": "bun run tools/init.ts",
    "verify": "bun run tools/verify.ts",
    "verify:push": "bun run tools/verify-push.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json",
    "test": "bun test",
    "typecheck:core": "tsc -p tsconfig.core.json",
    "typecheck:game": "tsc -p tsconfig.game.json",
    "build": "node tools/build.mjs",
    "prepack": "npm run build",
    "test:package": "node tools/test-package.mjs"
  },
  "main": "./dist/app.js",
  "types": "./dist/app.d.ts",
  "exports": {
    ".": {
      "types": "./dist/app.d.ts",
      "import": "./dist/app.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "files": [
    "dist",
    "bunburner.config.jsonc"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ws": "^8.21.3"
  },
  "bin": {
    "bun-burner": "./dist/index.js"
  }
}
