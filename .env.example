# Listener defaults. Restart the application after changing settings.
BUN_BURNER_HOST=127.0.0.1
BUN_BURNER_PORT=12525

# Two-way source sync is off until explicitly enabled.
BUN_BURNER_SYNC_ENABLED=false

# Relative to the directory where you start the app, or use an absolute path.
# Example: /home/yourname/Projects/bitburner-scripts
# The folder must already exist. ./scripts is provided for a quick start.
BUN_BURNER_SYNC_ROOT=./scripts

# The selected folder maps directly to this game server (no home subfolder needed).
BUN_BURNER_SYNC_SERVER=home
