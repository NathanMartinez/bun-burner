{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "paths": { "@ns": ["./NetscriptDefinitions.d.ts"] }
  },
  "include": ["NetscriptDefinitions.d.ts", "scripts/**/*.ts", "scripts/**/*.tsx", "examples/game-types.ts"],
  "exclude": ["node_modules", "scripts/.bun-burner"]
}
